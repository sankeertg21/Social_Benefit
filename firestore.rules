rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: triageResults
    // Fields:
    //   - userId: string (required)
    //   - category: string (required)
    //   - severityLevel: string (required)
    //   - verifiedSummary: string (required)
    //   - actionPlan: list (required)
    //   - dispatchEntities: list (required)
    //   - rationale: string (optional)
    //   - createdAt: timestamp (required)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTriageResult(data) {
      return data.keys().hasAll(['userId', 'category', 'severityLevel', 'verifiedSummary', 'actionPlan', 'dispatchEntities', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.category is string && data.category.size() > 0 && data.category.size() < 500 &&
             data.severityLevel in ['Low', 'Medium', 'High', 'Critical', 'Unknown'] &&
             data.verifiedSummary is string && data.verifiedSummary.size() > 0 && data.verifiedSummary.size() < 10000 &&
             data.actionPlan is list && data.actionPlan.size() >= 0 && data.actionPlan.size() < 100 &&
             data.dispatchEntities is list && data.dispatchEntities.size() >= 0 && data.dispatchEntities.size() < 50 &&
             data.createdAt is timestamp;
    }

    match /triageResults/{resultId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidTriageResult(request.resource.data);
      allow update, delete: if false; // Triage results are immutable for now
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
